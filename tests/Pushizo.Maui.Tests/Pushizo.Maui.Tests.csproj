<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Paylaşılan (platformdan bağımsız) katmanın birim testleri: sahte yerel köprü (FakeNativeBridge) ile BridgePlatform
    üzerinden tam JSON yolu, doğrulama, olay yönlendirme ve hata eşleme test edilir.
    Çalıştırma (Android/iOS iş yükü gerekmez): dotnet test -p:PushizoIncludeAndroid=false
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PushizoSdk.Maui.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pushizo.Maui\Pushizo.Maui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Platformlar arası ortak test vektörleri (Android/iOS/Flutter ile aynı dosya). -->
    <None Include="..\..\..\testdata\messaging-vectors.json" Link="testdata\messaging-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
