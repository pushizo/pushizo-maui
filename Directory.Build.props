<Project>
  <!-- Pushizo .NET MAUI SDK: tüm projelerde ortak sürüm ve derleme ayarları. -->
  <PropertyGroup>
    <PushizoVersion>0.1.0</PushizoVersion>
    <!-- Yerel Android SDK'sının (sdk/android) yayın sürümü; binding paketi bu sürümü sarar. -->
    <PushizoNativeAndroidVersion>0.1.0</PushizoNativeAndroidVersion>
    <!-- MAUI paket sürümleri hedef .NET sürümüne göre seçilir (MAUI 9 paketleri net8.0 hedeflerini içermez). -->
    <MauiVersion Condition="'$(MauiVersion)' == '' and $(TargetFramework.StartsWith('net8.0'))">8.0.100</MauiVersion>
    <MauiVersion Condition="'$(MauiVersion)' == ''">9.0.120</MauiVersion>
    <Version>$(PushizoVersion)</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Pushizo</Authors>
    <Company>Pushizo</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://docs.pushizo.com/docs/sdk/maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pushizo/pushizo-maui</RepositoryUrl>
    <PackageTags>pushizo;push;notifications;in-app;inbox;maui;android;ios</PackageTags>
    <!-- iOS hedefi yalnızca macOS'ta (Xcode + maui-ios iş yükü) ya da açıkça istendiğinde derlenir. -->
    <PushizoIncludeIos Condition="'$(PushizoIncludeIos)' == '' and $([MSBuild]::IsOSPlatform('osx'))">true</PushizoIncludeIos>
    <!--
      Android hedefi varsayılan olarak derlenir (maui-android iş yükü + JDK 17 + Android SDK gerekir). İş yükü olmayan
      makinelerde (ör. yalnızca paylaşılan katmanın birim testleri) -p:PushizoIncludeAndroid=false verilir.
    -->
    <PushizoIncludeAndroid Condition="'$(PushizoIncludeAndroid)' == ''">true</PushizoIncludeAndroid>
    <!-- net9.0 hedefleri yalnızca .NET 9+ SDK ile eklenir (.NET 8 SDK'sı net9.0 hedefini geri yükleyemez). -->
    <PushizoNet9 Condition="'$(NETCoreSdkVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '9.0'))">true</PushizoNet9>
    <PushizoAndroidTargets>net8.0-android</PushizoAndroidTargets>
    <PushizoAndroidTargets Condition="'$(PushizoNet9)' == 'true'">net8.0-android;net9.0-android</PushizoAndroidTargets>
    <PushizoIosTargets>net8.0-ios</PushizoIosTargets>
    <PushizoIosTargets Condition="'$(PushizoNet9)' == 'true'">net8.0-ios;net9.0-ios</PushizoIosTargets>
  </PropertyGroup>
</Project>
