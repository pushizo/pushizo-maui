<Project Sdk="Microsoft.NET.Sdk">
  <!--
    HeroSignal iOS SDK'sı için .NET iOS binding'i. Yerel Swift SDK'sı (sdk/ios) @objc yüzeyi sunmadığından küçük bir
    Swift cephesi (native/Sources/HeroSignalMauiBridge/HSMauiBridge.swift) dinamik framework olarak derlenir ve bağlanır.
    xcframework yoksa derleme sırasında native/build-xcframework.sh ile bu projenin build/native klasörüne üretilir
    (macOS + Xcode 15+). Hazır framework kullanmak için: -p:HeroSignalIosXcframework=<yol>.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(HeroSignalIosTargets)</TargetFrameworks>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <IsBindingProject>true</IsBindingProject>
    <NoBindingEmbedding>true</NoBindingEmbedding>
    <RootNamespace>HeroSignalSdk.Native.iOS</RootNamespace>
    <AssemblyName>HeroSignal.Maui.iOS.Binding</AssemblyName>
    <PackageId>HeroSignal.Maui.iOS.Binding</PackageId>
    <Description>HeroSignal iOS SDK'sı için .NET iOS binding'i (@objc Swift cephesi). Doğrudan değil, HeroSignal.Maui üzerinden kullanılır.</Description>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <HeroSignalNativeDir>$(MSBuildProjectDirectory)/build/native</HeroSignalNativeDir>
    <HeroSignalIosXcframework Condition="'$(HeroSignalIosXcframework)' == ''">$(HeroSignalNativeDir)/HeroSignalMauiBridge.xcframework</HeroSignalIosXcframework>
  </PropertyGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="$(HeroSignalIosXcframework)">
      <Kind>Framework</Kind>
      <SmartLink>false</SmartLink>
      <Frameworks>Foundation UIKit UserNotifications</Frameworks>
    </NativeReference>
  </ItemGroup>

  <Target Name="HeroSignalBuildXcframework" BeforeTargets="PrepareForBuild;_PrepareNativeReferences" Condition="!Exists('$(HeroSignalIosXcframework)')">
    <Message Importance="high" Text="HeroSignal: iOS köprü framework'ü üretiliyor" />
    <Exec Command="&quot;$(MSBuildProjectDirectory)/native/build-xcframework.sh&quot; &quot;$(HeroSignalNativeDir)&quot;" />
    <Error Condition="!Exists('$(HeroSignalIosXcframework)')" Text="HeroSignal: xcframework üretilemedi: $(HeroSignalIosXcframework)" />
  </Target>

  <Target Name="HeroSignalCleanXcframework" AfterTargets="Clean">
    <RemoveDir Directories="$(HeroSignalNativeDir)" />
  </Target>
</Project>
