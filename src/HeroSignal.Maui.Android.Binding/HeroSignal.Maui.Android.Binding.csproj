<Project Sdk="Microsoft.NET.Sdk">
  <!--
    sdk/android yerel SDK'sının (com.herosignal:herosignal-android) Xamarin.Android binding'i.
    AAR, derleme sırasında sdk/android kaynaklarından Gradle ile bu projenin build/native klasörüne üretilir
    (sdk/android altına çıktı yazılmaz). Hazır bir AAR kullanmak için: -p:HeroSignalAndroidAar=<yol>.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RootNamespace>HeroSignalSdk.Native.Android</RootNamespace>
    <AssemblyName>HeroSignal.Maui.Android.Binding</AssemblyName>
    <PackageId>HeroSignal.Maui.Android.Binding</PackageId>
    <Description>HeroSignal Android SDK (com.herosignal:herosignal-android) için .NET Android binding'i. Doğrudan değil, HeroSignal.Maui üzerinden kullanılır.</Description>
    <IsPackable>true</IsPackable>
    <HeroSignalNativeDir>$(MSBuildProjectDirectory)\build\native</HeroSignalNativeDir>
    <HeroSignalAndroidAar Condition="'$(HeroSignalAndroidAar)' == ''">$(HeroSignalNativeDir)\gradle\herosignal\outputs\aar\herosignal-release.aar</HeroSignalAndroidAar>
    <HeroSignalAndroidSdkDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\android'))</HeroSignalAndroidSdkDir>
    <HeroSignalGradleInitScript>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\tools\herosignal-native-out.init.gradle'))</HeroSignalGradleInitScript>
  </PropertyGroup>

  <ItemGroup>
    <TransformFile Include="Transforms\Metadata.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yerel SDK'nın Maven bağımlılıklarının .NET karşılıkları (sdk/android/herosignal/build.gradle.kts). -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.0.21.4" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.9.0.4" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.15.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Work.Work.Runtime.Ktx" Version="2.10.0.5" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.8.7.4" />
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="124.1.2" />
  </ItemGroup>

  <ItemGroup>
    <AndroidLibrary Include="$(HeroSignalAndroidAar)" Link="Jars\herosignal-release.aar" />
  </ItemGroup>

  <!--
    AAR yoksa sdk/android'den üretir. Gradle çıktı (build), proje önbelleği (.gradle) ve Kotlin oturum klasörü
    (.kotlin) bu projenin build/native klasörüne yönlendirilir. Gereken ortam: JAVA_HOME (JDK 17) ve
    ANDROID_HOME (ya da sdk/android/local.properties içindeki sdk.dir), PATH'te gradle 8.x.
  -->
  <Target Name="HeroSignalBuildNativeAar" BeforeTargets="PrepareForBuild;_ResolveLibraryProjectImports;CollectPackageReferences" Condition="!Exists('$(HeroSignalAndroidAar)')">
    <Message Importance="high" Text="HeroSignal: yerel Android AAR üretiliyor ($(HeroSignalAndroidSdkDir))" />
    <Exec Command="gradle -p &quot;$(HeroSignalAndroidSdkDir)&quot; --project-cache-dir &quot;$(HeroSignalNativeDir)\.gradle-project&quot; -I &quot;$(HeroSignalGradleInitScript)&quot; -PherosignalOutDir=&quot;$(HeroSignalNativeDir)\gradle&quot; -Pkotlin.project.persistent.dir=&quot;$(HeroSignalNativeDir)\.kotlin&quot; :herosignal:assembleRelease --console=plain -q" />
    <Error Condition="!Exists('$(HeroSignalAndroidAar)')" Text="HeroSignal: AAR üretilemedi: $(HeroSignalAndroidAar)" />
  </Target>

  <Target Name="HeroSignalCleanNativeAar" AfterTargets="Clean">
    <RemoveDir Directories="$(HeroSignalNativeDir)\gradle" />
  </Target>
</Project>
